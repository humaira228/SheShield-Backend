PORT=8080
DB_PATH=./data/sheshield.db
# Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
CORS_ORIGIN=*

# How the server sends SOS texts. "log" only prints them (no real SMS, no cost).
SMS_PROVIDER=log

# Days to keep derived motion events (fall/sprint/struggle) before they are purged.
MOTION_RETENTION_DAYS=30
